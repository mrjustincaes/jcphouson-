                    <h4>Management Strategy &amp; Consulting</h4>
                    <p>Executive-level consulting to streamline creative operations, optimize brand positioning, and maximize overall operational impact within competitive global markets.</p>
                </div>
                <div class="service-card">
                    <h4>Enterprise Branding Architecture</h4>
                    <p>Complete execution of brand strategies from initial conceptualization to full multi-channel rollout, serving enterprise operations and high-profile creators.</p>
                </div>
            </div>
        </div>

        <!-- CONTACT VIEW SECTION -->
        <div class="stage-section" id="contactView">
            <div class="section-header">
                <h2>Initiate <span>Contact</span></h2>
            </div>
            <div class="contact-container">
                <div class="contact-info-block">
                    <div class="contact-method">
                        <label>Direct Inquiries</label>
                        <a href="tel:2818491590">281.849.1590</a>
                    </div>
                    <div class="contact-method">
                        <label>Secure Mail Network</label>
                        <a href="mailto:design@jcphouston.com">design@jcphouston.com</a>
                    </div>
                    <div class="contact-method">
                        <label>Headquarters</label>
                        <p>Houston, Texas</p>
                    </div>
                </div>
                
                <div class="form-interaction-area">
                    <form class="contact-form" id="mainContactForm">
                        <div class="error-banner" id="formErrorBanner"></div>
                        <div class="form-group">
                            <input type="text" id="clientName" name="name" required placeholder=" ">
                            <label for="clientName">Corporate Identity / Name</label>
                        </div>
                        <div class="form-group">
                            <input type="email" id="clientEmail" name="email" required placeholder=" ">
                            <label for="clientEmail">Email Endpoint</label>
