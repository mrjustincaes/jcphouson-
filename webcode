                            <textarea id="clientMessage" name="message" rows="5" required placeholder=" "></textarea>
                            <label for="clientMessage">Project Framework Brief</label>
                        </div>
                        <button type="submit" class="submit-btn" id="formSubmitBtn">
                            <span class="btn-text">Transmit Framework</span>
                            <!-- SVG Paper Plane -->
                            <svg class="paper-plane" viewBox="0 0 24 24">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </form>
                    
                    <div class="success-overlay" id="successMessage">
                        <h3>SENT</h3>
                        <p>Your framework has been successfully transmitted to our secure network.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Persistent Footer -->
    <footer>
        <div class="footer-logo">
            <img src="Logo.png" alt="Justin Case Production Logo">
        </div>
        <div class="footer-nav">
            <a href="#home" class="nav-trigger" data-target="homeView">Home</a>
            <a href="#services" class="nav-trigger" data-target="servicesView">Services</a>
            <a href="#contact" class="nav-trigger" data-target="contactView">Contact</a>
        </div>
        <div class="copyright">
            &copy; 2026 Justin Case Production. All Rights Reserved. Securing Creative Legacy.
        </div>
    </footer>

    <script>
        // --- 1. Cursor Inertial Tracking Engine ---
        const cursor = document.getElementById('customCursor');
        const dot = document.getElementById('customCursorDot');

        document.addEventListener('mousemove', (e) => {
            dot.style.left = `${e.clientX}px`;
            dot.style.top = `${e.clientY}px`;
            
            cursor.animate({
                left: `${e.clientX}px`,
                top: `${e.clientY}px`
            }, { duration: 250, fill: "forwards" });
        });

        // --- 2. Advanced 3D Spatial Gyro Interaction ---
        const unifyingCard = document.getElementById('unifyingCard');

        document.addEventListener('mousemove', (e) => {
            if(!unifyingCard) return;
            const xAxis = (window.innerWidth / 2 - e.clientX) / 25;
            const yAxis = (window.innerHeight / 2 - e.clientY) / 25;
            
            unifyingCard.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });

        document.addEventListener('mouseleave', () => {
            if(unifyingCard) {
                unifyingCard.style.transform = `rotateY(0deg) rotateX(0deg)`;
            }
        });

        // --- 3. Light Speed View Routing Engine ---
        const links = document.querySelectorAll('.nav-trigger');
        const sections = document.querySelectorAll('.stage-section');
        let isAnimating = false;

        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                
                if (isAnimating) return;

                const targetID = link.getAttribute('data-target');
                const currentActive = document.querySelector('.stage-section.active');

                if (currentActive && currentActive.id === targetID) return;

                isAnimating = true;
                document.body.classList.add('is-warping');

                links.forEach(l => l.classList.remove('active'));
                
                document.querySelectorAll(`.nav-trigger[data-target="${targetID}"]`).forEach(l => {
                    l.classList.add('active');
                });

                if (currentActive) {
                    currentActive.classList.remove('active');
                    currentActive.classList.add('warp-out');
                }

                const targetSection = document.getElementById(targetID);
                targetSection.classList.remove('warp-out');
                
                setTimeout(() => {
                    targetSection.classList.add('active');
                    window.scrollTo({ top: 0, behavior: 'instant' });
                }, 50);

                setTimeout(() => {
                    if (currentActive) {
                        currentActive.classList.remove('warp-out');
                    }
                    isAnimating = false;
                    document.body.classList.remove('is-warping');
                }, 1000); 
            });
        });

        // --- 4. AJAX Form Submission & Paper Plane Logic ---
        const contactForm = document.getElementById('mainContactForm');
        const formSubmitBtn = document.getElementById('formSubmitBtn');
        const successMessage = document.getElementById('successMessage');
        const errorBanner = document.getElementById('formErrorBanner');

        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();

            // Clear any previous errors
            errorBanner.classList.remove('active');
            errorBanner.innerText = "";
            
            // Trigger the plane flying animation
            formSubmitBtn.classList.add('sending');

            const formData = {
                name: document.getElementById('clientName').value,
                email: document.getElementById('clientEmail').value,
                message: document.getElementById('clientMessage').value,
                _subject: "New Project Framework from JCP Website",
                _captcha: "false" // CRITICAL: This bypasses the visual captcha page which breaks AJAX
            };

            fetch("https://formsubmit.co/ajax/design@jcphouston.com", {
                method: "POST",
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(formData)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                // Wait for the paper plane animation to physically clear the button
                setTimeout(() => {
                    contactForm.classList.add('submitted');
                    successMessage.classList.add('active');
                    
                    // Reset the form in the background
                    contactForm.reset();
                    formSubmitBtn.classList.remove('sending');
                    
                    // Reset view after 5 seconds
                    setTimeout(() => {
                        successMessage.classList.remove('active');
                        contactForm.classList.remove('submitted');
                    }, 5000);
                }, 900);
            })
            .catch(error => {
                console.error('Transmission Error:', error);
                
                // Show visual error to the user
                errorBanner.innerText = "Connection failed. You may need to run this file on a local server, or use the direct email link above.";
                errorBanner.classList.add('active');
                
                // Reset the button
                formSubmitBtn.classList.remove('sending');
            });
        });
    </script>
</body>
</html>
